# Afriverse Alpha — Mozilla build config
# Inherits Zen's upstream mozconfig then overrides branding.

# Pull in Zen's base config if present
if [ -f "$topsrcdir/mozconfig.cfg" ]; then
  . "$topsrcdir/mozconfig.cfg"
fi

# Branding
ac_add_options --with-app-name=afriverse
ac_add_options --with-branding=browser/branding/afriverse
ac_add_options --with-distribution-id=org.afriversedao

# Optimised release build
ac_add_options --enable-release
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests

# Telemetry off
ac_add_options --disable-crashreporter
ac_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options MOZ_DATA_REPORTING=
ac_add_options MOZ_SERVICES_HEALTHREPORT=

mk_add_options MOZ_MAKE_FLAGS="-j$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"
